# OpenEden Docker / GitHub Release 环境配置
# 复制为与 compose.yaml 同目录的 .env；以 # 开头的配置默认不启用。
# 修改后执行 docker compose up -d --no-deps --force-recreate server。
# Release 附件中的镜像值会固定到该次构建的摘要。

# 镜像和主机端口；设为 0.0.0.0 可监听所有主机网卡。
OPENEDEN_IMAGE=ghcr.io/lightwhite520/openeden:latest
OPENEDEN_BIND_ADDRESS=127.0.0.1
OPENEDEN_HTTP_PORT=8080
# 容器端口由 compose.yaml 固定为 8080；不要用它修改主机映射端口。
# OPENEDEN_SERVER_PORT=8080
# 首次初始化原生推理库可能较慢，单位毫秒。
OPENEDEN_STARTUP_TIMEOUT_MS=600000

# LLM：api_key 或 chatgpt。chatgpt 需要先完成订阅账号登录。
OPENEDEN_LLM_AUTH_MODE=api_key
OPENEDEN_OPENAI_API_KEY=replace-with-your-api-key
OPENEDEN_OPENAI_BASE_URL=https://api.openai.com/v1
OPENEDEN_OPENAI_MODEL=your-responses-compatible-model
OPENEDEN_LLM_REASONING_EFFORT=medium
OPENEDEN_LLM_TEMPERATURE_MIN=0.2
OPENEDEN_LLM_TEMPERATURE_MAX=1.0
# 未设置时不主动限制输出 token；包括推理和可见输出。
# OPENEDEN_LLM_MAX_OUTPUT_TOKENS=32000
# /model 需要服务器和本机 CLI 设置同一个随机令牌。
# OPENEDEN_MODEL_SETTINGS_TOKEN=replace-with-a-long-random-secret
# 以下目录由 compose.yaml 固定，均保存在 operator 持久卷中。
# OPENEDEN_MODEL_SETTINGS_DIR=/app/data/operator/models
# OPENEDEN_CHATGPT_AUTH_DIR=/app/data/operator/chatgpt

# 提示词缓存：relay_append_only（默认）或 official_explicit。
# official_explicit 还需要启用能力探测，只有提供商能力验证通过才发送相关字段。
OPENEDEN_OPENAI_PROMPT_CACHING_POLICY=relay_append_only
OPENEDEN_OPENAI_CAPABILITY_PROBE_ENABLED=false
OPENEDEN_OPENAI_ROUTING_FINGERPRINT=default
OPENEDEN_OPENAI_CAPABILITY_PROBE_TTL_SECONDS=900
OPENEDEN_OPENAI_PROVIDER_POLICY_REVISION=responses-v1
OPENEDEN_SYSTEM_SCHEMA_REVISION=openeden-output-schema-v1
OPENEDEN_PERSONA_REVISION=persona-v1
OPENEDEN_DIALOGUE_NAMESPACE=openeden-dialogue-v1

# 人格和模型后端；人格内容、成长起点在 persona YAML 中配置。
OPENEDEN_MODEL_BACKEND=djl
OPENEDEN_PERSONA_PATH=persona/atri.yaml
OPENEDEN_DJL_ENGINE=PyTorch
OPENEDEN_DJL_MODEL_NAME=model
OPENEDEN_THYMOS_DEVICE=cpu

# 独立模型包：默认使用本次 Release 的附件，模型内容不变时复用缓存。
# 可填写相同模型包的镜像直链，SHA-256 校验仍保持启用。
# OPENEDEN_MODEL_DOWNLOAD_URL=https://your-mirror.example/openeden-models-HASH.tar.gz
# 以下为镜像内的默认目录；改变缓存目录时需同步修改持久卷挂载。
# OPENEDEN_MODEL_MANIFEST_DIR=/opt/openeden-models
# OPENEDEN_MODEL_CACHE_DIR=/app/data/models
# DJL_CACHE_DIR=/home/openeden/.djl.ai
# 以下路径由容器入口自动解析到 bundles/<SHA256>/ 内，通常不要设置。
# 仅自备完整模型并挂载相应路径时覆盖；不能填写 Windows 主机路径。
# OPENEDEN_LOCAL_MODEL_ARTIFACT=/app/data/models/custom/local-model-artifact.json
# OPENEDEN_DJL_VQVAE_MODEL_PATH=/app/data/models/custom/djl/vqvae
# OPENEDEN_DJL_TEXT_MODEL_PATH=/app/data/models/custom/djl/text
# OPENEDEN_DJL_EMOTIONAL_MODEL_PATH=/app/data/models/custom/djl/emotional
# OPENEDEN_DJL_AFFECT_MODEL_PATH=/app/data/models/custom/thymos-6d
# 以下两个 URL 只用于源码 Gradle 下载任务，不控制 Docker 模型包下载。
# OPENEDEN_LOCAL_MODEL_ARTIFACT_URL=https://huggingface.co/0x4C57/openeden-codebook-base-model/resolve/main/local-model-artifact.json
# OPENEDEN_DJL_AFFECT_MODEL_URL=https://huggingface.co/0x4C57/Thymos-6D/resolve/main

# SQLite 数据和维护导出目录由 compose.yaml 固定，保存在对应持久卷中。
# OPENEDEN_RUNTIME_DB_PATH=/app/data/runtime/openeden.db
# OPENEDEN_MAINTENANCE_EXPORT_ROOT=/app/data/exports
# 启用受保护的维护接口时设置随机令牌；不设置则禁用。
# OPENEDEN_MAINTENANCE_TOKEN=replace-with-a-long-random-secret

# 宿主身份：平台和用户 ID 必须同时设置，且与发送者精确匹配（区分大小写）。
# CLI 示例；使用 QQ 时将平台改为 QQ，用户 ID 改为对应 QQ 号。
# CLI 用户 ID 可查看连接提示中的 CLI:<userId> 或 ~/.openeden/config.json。
# 不配置时所有发送者均为普通对话者；称呼仅对匹配的宿主生效。
# OPENEDEN_HOST_PLATFORM=CLI
# OPENEDEN_HOST_USER_ID=your-cli-user-id
# OPENEDEN_HOST_ADDRESS=主人

# 主动消息接收者：独立于宿主身份，平台和用户 ID 必须同时设置。
# 启用 OneBot 时接收者平台必须为 QQ；只在 CLI 配置接收者不会建立推送通道。
# OPENEDEN_OWNER_PLATFORM=QQ
# OPENEDEN_OWNER_USER_ID=123456789

# CLI /inspect on：服务器启用诊断，并与本机 CLI 设置相同令牌。
OPENEDEN_ENABLE_CLI_DIAGNOSTICS=false
# OPENEDEN_CLI_DIAGNOSTICS_TOKEN=replace-with-a-long-random-secret
# 本机 PowerShell 启动前设置：
# $env:OPENEDEN_CLI_DIAGNOSTICS_TOKEN="与服务器相同的令牌"
# $env:OPENEDEN_MODEL_SETTINGS_TOKEN="与服务器相同的令牌"
# npm start
# npm / JVM CLI 不自动读取服务器 .env，连接地址和用户 ID 使用 ~/.openeden/config.json。
# 可选：在本机 CLI 环境中设置 NO_COLOR=1 禁用颜色。

# Qdrant：默认启用；设为 false 时使用进程内向量索引。
# Compose 仍会启动 qdrant 容器；仅关闭本配置不会移除 Compose 服务依赖。
OPENEDEN_VECTOR_DB_ENABLED=true
# 地址由 compose.yaml 固定为 http://qdrant:6333；外部 Qdrant 需同时修改 Compose。
# OPENEDEN_QDRANT_URL=http://qdrant:6333
OPENEDEN_QDRANT_API_KEY=
OPENEDEN_QDRANT_COLLECTION=openeden_memory
OPENEDEN_EMBEDDING_MODEL_ID=local-v1
OPENEDEN_QDRANT_TIMEOUT_MS=2000
OPENEDEN_QDRANT_SYNC_INTERVAL_SECONDS=30
OPENEDEN_QDRANT_SYNC_BATCH_SIZE=128
OPENEDEN_QDRANT_FAILURE_THRESHOLD=3

# QQ / OneBot v11 反向 WebSocket；默认关闭。
OPENEDEN_ONEBOT_ENABLED=false
OPENEDEN_ONEBOT_PATH=/onebot/v11
OPENEDEN_ONEBOT_ACCESS_TOKEN=
OPENEDEN_ONEBOT_BOT_SELF_ID=
OPENEDEN_ONEBOT_GROUP_POLICY=MENTION_ONLY
OPENEDEN_ONEBOT_EVENT_QUEUE_CAPACITY=64
OPENEDEN_ONEBOT_EVENT_WORKERS=4
OPENEDEN_ONEBOT_ACTION_TIMEOUT_MS=10000
OPENEDEN_ONEBOT_MAX_ACTION_RETRIES=2

# 日记生成：向量变化阈值、时间窗口（小时）、扫描间隔（秒）和单批原始记忆数。
OPENEDEN_DIARY_DELTA_THRESHOLD=0.25
OPENEDEN_DIARY_ELAPSED_HOURS=5
OPENEDEN_DIARY_SCAN_INTERVAL_SECONDS=60
OPENEDEN_DIARY_MAX_RAW_MEMORIES=32
