# OpenEden Docker / GitHub Release 环境配置（精简版）
# 完整配置见 deploy/.env.full.example；Release 附件名为 openeden.env.full.example。
# 复制为与 compose.yaml 同目录的 .env，修改后执行 docker compose up -d --no-deps --force-recreate server。

# 【必填·已提供】Release 附件会填入本次镜像摘要，可直接保留。
OPENEDEN_IMAGE=ghcr.io/lightwhite520/openeden:latest
# 【可选】主机监听地址与端口；0.0.0.0 表示监听所有主机网卡。
OPENEDEN_BIND_ADDRESS=127.0.0.1
OPENEDEN_HTTP_PORT=8080

# 【按需必填】api_key 模式必须替换 API Key 和模型 ID。
# chatgpt 模式需先登录订阅账号，再通过 /model 选择模型。
OPENEDEN_LLM_AUTH_MODE=api_key
OPENEDEN_OPENAI_API_KEY=replace-with-your-api-key
OPENEDEN_OPENAI_MODEL=your-responses-compatible-model
# 【按需必填】使用兼容服务时填写对应地址；官方 API 保留默认值。
OPENEDEN_OPENAI_BASE_URL=https://api.openai.com/v1

# 【可选】首次初始化原生推理库的启动时限（毫秒）。
OPENEDEN_STARTUP_TIMEOUT_MS=600000
# Qdrant、模型缓存和容器内部路径由镜像与 Compose 默认配置处理。

# 【按需必填】识别宿主时，同时取消下面两项注释并填写，区分大小写。
# CLI 用户 ID 见连接提示 CLI:<userId> 或 ~/.openeden/config.json。
# OPENEDEN_HOST_PLATFORM=CLI
# OPENEDEN_HOST_USER_ID=your-cli-user-id
# 【可选】仅对匹配的宿主使用此称呼。
# OPENEDEN_HOST_ADDRESS=主人

# 【可选】启用 /inspect on 时改为 true。
OPENEDEN_ENABLE_CLI_DIAGNOSTICS=false
# 【按需必填】诊断启用后，服务器和 CLI 必须设置同一随机令牌。
# OPENEDEN_CLI_DIAGNOSTICS_TOKEN=replace-with-a-long-random-secret
# CLI 不自动读取 .env；PowerShell 启动前设置 $env:OPENEDEN_CLI_DIAGNOSTICS_TOKEN="同一个令牌"。
# CLI 连接地址和用户 ID 在 ~/.openeden/config.json 中配置。
