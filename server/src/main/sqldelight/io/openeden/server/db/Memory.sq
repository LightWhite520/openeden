CREATE TABLE memory_entries (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    user_id TEXT NOT NULL,
    platform TEXT NOT NULL,
    room TEXT NOT NULL,
    kind TEXT NOT NULL,
    content TEXT NOT NULL,
    tags_json TEXT NOT NULL,
    created_at_ms INTEGER NOT NULL,
    snapshot_l REAL NOT NULL,
    snapshot_p REAL NOT NULL,
    snapshot_e REAL NOT NULL,
    snapshot_s REAL NOT NULL,
    snapshot_tau REAL NOT NULL,
    snapshot_v REAL NOT NULL,
    snapshot_m REAL NOT NULL,
    snapshot_f REAL NOT NULL,
    omega_state REAL NOT NULL,
    delta_l REAL NOT NULL,
    delta_p REAL NOT NULL,
    delta_e REAL NOT NULL,
    delta_s REAL NOT NULL,
    delta_tau REAL NOT NULL,
    delta_v REAL NOT NULL,
    delta_m REAL NOT NULL,
    delta_f REAL NOT NULL,
    origin_l REAL NOT NULL,
    origin_p REAL NOT NULL,
    origin_e REAL NOT NULL,
    origin_s REAL NOT NULL,
    origin_tau REAL NOT NULL,
    origin_v REAL NOT NULL,
    origin_m REAL NOT NULL,
    origin_f REAL NOT NULL,
    source_turn_ids_json TEXT NOT NULL DEFAULT '[]',
    source_memory_ids_json TEXT NOT NULL DEFAULT '[]',
    content_fingerprint TEXT,
    lineage_version INTEGER NOT NULL DEFAULT 1,
    incarnation_id TEXT NOT NULL,
    source_session_id TEXT NOT NULL,
    canonical_subject_id TEXT NOT NULL,
    visibility_kind TEXT NOT NULL,
    visibility_subject_id TEXT,
    visibility_session_id TEXT
);

CREATE INDEX memory_entries_incarnation_created
ON memory_entries(incarnation_id, created_at_ms DESC, id DESC);

CREATE TABLE memory_embeddings (
    memory_id TEXT NOT NULL PRIMARY KEY REFERENCES memory_entries(id) ON DELETE CASCADE,
    model_id TEXT NOT NULL,
    semantic_json TEXT NOT NULL,
    emotional_json TEXT NOT NULL,
    status TEXT NOT NULL
);

CREATE TABLE memory_vector_sync (
    memory_id TEXT NOT NULL PRIMARY KEY REFERENCES memory_entries(id) ON DELETE CASCADE,
    model_id TEXT NOT NULL,
    status TEXT NOT NULL,
    attempts INTEGER NOT NULL,
    available_at_ms INTEGER NOT NULL,
    last_error TEXT,
    updated_at_ms INTEGER NOT NULL
);

CREATE INDEX memory_vector_sync_due_index
ON memory_vector_sync(status, available_at_ms, memory_id);

selectById:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.id = ?;

selectByIds:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.id IN ?;

selectBySession:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.session_id = ?
ORDER BY memory_entries.created_at_ms DESC;

selectByIncarnation:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.incarnation_id = ?
ORDER BY memory_entries.created_at_ms DESC;

selectStable:
SELECT snapshot_l, snapshot_p, snapshot_e, snapshot_s, snapshot_tau, snapshot_v, snapshot_m, snapshot_f
FROM memory_entries
WHERE incarnation_id = ? AND tags_json LIKE '%"daily"%' AND tags_json LIKE '%"stable"%'
ORDER BY created_at_ms DESC
LIMIT ?;

selectRecent:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.session_id = ?
ORDER BY memory_entries.created_at_ms DESC
LIMIT ?;

selectRawMemoryRange:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.session_id = ?
  AND memory_entries.kind = 'RAW'
  AND (? = '' OR memory_entries.created_at_ms > ? OR (memory_entries.created_at_ms = ? AND memory_entries.id > ?))
  AND (? = '' OR memory_entries.created_at_ms < ? OR (memory_entries.created_at_ms = ? AND memory_entries.id <= ?))
ORDER BY memory_entries.created_at_ms ASC, memory_entries.id ASC
LIMIT ?;

selectLatestRawMemory:
SELECT memory_entries.*, memory_embeddings.model_id, memory_embeddings.semantic_json,
       memory_embeddings.emotional_json, memory_embeddings.status
FROM memory_entries
LEFT JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
WHERE memory_entries.session_id = ? AND memory_entries.kind = 'RAW'
ORDER BY memory_entries.created_at_ms DESC, memory_entries.id DESC
LIMIT 1;

selectRawSessions:
SELECT DISTINCT session_id FROM memory_entries WHERE kind = 'RAW';

selectNarrativeMemories:
SELECT id, content, created_at_ms
FROM memory_entries
WHERE kind = 'NARRATIVE'
ORDER BY created_at_ms ASC, id ASC;

countMemoryEntries:
SELECT COUNT(*) FROM memory_entries;

deleteAllMemoryEmbeddings:
DELETE FROM memory_embeddings;

deleteAllMemoryEntries:
DELETE FROM memory_entries;

deleteAllDiaryTasks:
DELETE FROM diary_tasks;

deleteAllDiaryCheckpoints:
DELETE FROM diary_checkpoints;

deleteAllTraceSpans:
DELETE FROM trace_spans;

insertEntry:
INSERT OR REPLACE INTO memory_entries(
    id, session_id, user_id, platform, room, kind, content, tags_json, created_at_ms,
    snapshot_l, snapshot_p, snapshot_e, snapshot_s, snapshot_tau, snapshot_v, snapshot_m, snapshot_f,
    omega_state, delta_l, delta_p, delta_e, delta_s, delta_tau, delta_v, delta_m, delta_f,
    origin_l, origin_p, origin_e, origin_s, origin_tau, origin_v, origin_m, origin_f,
    source_turn_ids_json, source_memory_ids_json, content_fingerprint, lineage_version,
    incarnation_id, source_session_id, canonical_subject_id, visibility_kind,
    visibility_subject_id, visibility_session_id
) VALUES (
    ?, ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?, ?, ?,
    ?, ?, ?, ?,
    ?, ?, ?, ?, ?, ?
);

upsertEmbedding:
INSERT OR REPLACE INTO memory_embeddings(memory_id, model_id, semantic_json, emotional_json, status)
VALUES (?, ?, ?, ?, ?);

upsertVectorSync:
INSERT OR REPLACE INTO memory_vector_sync(memory_id, model_id, status, attempts, available_at_ms, last_error, updated_at_ms)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectVectorSync:
SELECT memory_id, model_id, status, attempts, available_at_ms, last_error, updated_at_ms
FROM memory_vector_sync WHERE memory_id = ?;

selectDueVectorSync:
SELECT memory_id, model_id, status, attempts, available_at_ms, last_error, updated_at_ms
FROM memory_vector_sync
WHERE status = 'PENDING' AND available_at_ms <= ? AND (? = '' OR model_id = ?)
ORDER BY available_at_ms ASC, memory_id ASC
LIMIT ?;

claimVectorSync:
UPDATE memory_vector_sync SET status = 'RUNNING', updated_at_ms = ?
WHERE memory_id = ? AND status = 'PENDING';

markVectorSyncReady:
UPDATE memory_vector_sync SET status = 'READY', last_error = NULL, updated_at_ms = ?
WHERE memory_id = ? AND status = 'RUNNING';

rescheduleVectorSync:
UPDATE memory_vector_sync SET status = 'PENDING', attempts = ?, available_at_ms = ?, last_error = ?, updated_at_ms = ?
WHERE memory_id = ? AND status = 'RUNNING';

recoverRunningVectorSync:
UPDATE memory_vector_sync SET status = 'PENDING', available_at_ms = ?, updated_at_ms = ?
WHERE status = 'RUNNING';

countPendingVectorSync:
SELECT COUNT(*) FROM memory_vector_sync WHERE status = 'PENDING';

countDuePendingVectorSync:
SELECT COUNT(*) FROM memory_vector_sync
WHERE status = 'PENDING' AND available_at_ms <= ?;

countNonReadyVectorSync:
SELECT COUNT(*) FROM memory_vector_sync WHERE status <> 'READY';

selectReadyVectorSync:
SELECT memory_id
FROM memory_vector_sync
WHERE status = 'READY' AND model_id = ?
ORDER BY updated_at_ms ASC, memory_id ASC
LIMIT ?;

resetReadyVectorSync:
UPDATE memory_vector_sync
SET status = 'PENDING', attempts = 0, available_at_ms = ?, last_error = NULL, updated_at_ms = ?
WHERE memory_id = ? AND status = 'READY';

selectVectorSyncForModelRefresh:
SELECT memory_entries.id, memory_embeddings.model_id,
       COALESCE(memory_vector_sync.status, 'PENDING'),
       COALESCE(memory_vector_sync.attempts, 0),
       COALESCE(memory_vector_sync.available_at_ms, 0),
       memory_vector_sync.last_error,
       COALESCE(memory_vector_sync.updated_at_ms, 0)
FROM memory_entries
JOIN memory_embeddings ON memory_embeddings.memory_id = memory_entries.id
LEFT JOIN memory_vector_sync ON memory_vector_sync.memory_id = memory_entries.id
WHERE memory_embeddings.status = 'READY'
  AND (TRIM(memory_embeddings.model_id) = '' OR LOWER(memory_embeddings.model_id) = 'unknown' OR memory_embeddings.model_id != ?)
ORDER BY memory_entries.id ASC
LIMIT ?;

CREATE TABLE diary_tasks (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    source_memory_id TEXT,
    reason TEXT NOT NULL,
    status TEXT NOT NULL,
    attempts INTEGER NOT NULL,
    created_at_ms INTEGER NOT NULL,
    available_at_ms INTEGER NOT NULL,
    lease_expires_at_ms INTEGER,
    lease_token TEXT,
    last_error TEXT,
    incarnation_id TEXT NOT NULL,
    source_session_id TEXT NOT NULL,
    canonical_subject_id TEXT NOT NULL,
    visibility_kind TEXT NOT NULL,
    visibility_subject_id TEXT,
    visibility_session_id TEXT
);

CREATE INDEX diary_tasks_incarnation_status
ON diary_tasks(incarnation_id, status, available_at_ms, id);

insertDiaryTask:
INSERT INTO diary_tasks(
    id, session_id, source_memory_id, reason, status, attempts, created_at_ms, available_at_ms,
    lease_expires_at_ms, lease_token, last_error, incarnation_id, source_session_id,
    canonical_subject_id, visibility_kind, visibility_subject_id, visibility_session_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertDiaryTaskIfAbsent:
INSERT OR IGNORE INTO diary_tasks(
    id, session_id, source_memory_id, reason, status, attempts, created_at_ms, available_at_ms,
    lease_expires_at_ms, lease_token, last_error, incarnation_id, source_session_id,
    canonical_subject_id, visibility_kind, visibility_subject_id, visibility_session_id
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

countActiveDiaryTasks:
SELECT COUNT(*) FROM diary_tasks
WHERE session_id = ? AND status IN ('PENDING', 'RUNNING');

selectPendingDiaryTask:
SELECT id, session_id, source_memory_id, reason, status, attempts, available_at_ms, lease_expires_at_ms, lease_token, last_error,
       incarnation_id, source_session_id, canonical_subject_id, visibility_kind, visibility_subject_id, visibility_session_id
FROM diary_tasks
WHERE session_id = ? AND status = 'PENDING' AND available_at_ms <= ?
ORDER BY created_at_ms ASC LIMIT 1;

markDiaryTaskRunning:
UPDATE diary_tasks SET status = 'RUNNING', lease_expires_at_ms = ?, lease_token = ? WHERE id = ? AND status = 'PENDING';

completeDiaryTask:
UPDATE diary_tasks SET status = 'DONE', lease_expires_at_ms = NULL, lease_token = NULL WHERE id = ? AND status = 'RUNNING' AND lease_token = ?;

selectChanges:
SELECT changes();

failDiaryTask:
UPDATE diary_tasks SET status = ?, attempts = ?, available_at_ms = ?, lease_expires_at_ms = NULL, lease_token = NULL, last_error = ? WHERE id = ?;

failDiaryTaskOwned:
UPDATE diary_tasks SET status = ?, attempts = ?, available_at_ms = ?, lease_expires_at_ms = NULL, lease_token = NULL, last_error = ? WHERE id = ? AND status = 'RUNNING' AND lease_token = ?;

recoverExpiredDiaryTasks:
UPDATE diary_tasks SET status = 'PENDING', lease_expires_at_ms = NULL, lease_token = NULL
WHERE status = 'RUNNING' AND lease_expires_at_ms IS NOT NULL AND lease_expires_at_ms <= ?;

selectDiaryTask:
SELECT id, session_id, source_memory_id, reason, status, attempts, available_at_ms, lease_expires_at_ms, lease_token, last_error,
       incarnation_id, source_session_id, canonical_subject_id, visibility_kind, visibility_subject_id, visibility_session_id
FROM diary_tasks WHERE id = ?;

CREATE TABLE diary_checkpoints (
    session_id TEXT NOT NULL PRIMARY KEY,
    last_covered_raw_memory_id TEXT,
    last_successful_diary_at_ms INTEGER,
    last_narrative_memory_id TEXT
);

upsertDiaryCheckpoint:
INSERT OR REPLACE INTO diary_checkpoints(session_id, last_covered_raw_memory_id, last_successful_diary_at_ms, last_narrative_memory_id)
VALUES (?, ?, ?, ?)
;

selectDiaryCheckpoint:
SELECT last_covered_raw_memory_id, last_successful_diary_at_ms, last_narrative_memory_id
FROM diary_checkpoints WHERE session_id = ?;

selectDiaryCheckpointSessions:
SELECT session_id FROM diary_checkpoints;

CREATE TABLE trace_spans (
    span_id TEXT NOT NULL PRIMARY KEY,
    trace_id TEXT NOT NULL,
    turn_id TEXT NOT NULL,
    session_id TEXT NOT NULL,
    parent_span_id TEXT,
    stage TEXT NOT NULL,
    status TEXT NOT NULL,
    started_at_ms INTEGER NOT NULL,
    finished_at_ms INTEGER,
    tags_json TEXT NOT NULL,
    attributes_json TEXT NOT NULL,
    error_code TEXT,
    error_summary TEXT
);

insertTraceSpan:
INSERT OR REPLACE INTO trace_spans(
    span_id, trace_id, turn_id, session_id, parent_span_id, stage, status,
    started_at_ms, finished_at_ms, tags_json, attributes_json, error_code, error_summary
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTraceSpans:
SELECT span_id, trace_id, turn_id, session_id, parent_span_id, stage, status,
       started_at_ms, finished_at_ms, tags_json, attributes_json, error_code, error_summary
FROM trace_spans ORDER BY started_at_ms ASC;
