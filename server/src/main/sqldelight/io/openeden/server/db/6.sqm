ALTER TABLE session_state ADD COLUMN last_runtime_tick_at_ms INTEGER;

ALTER TABLE incarnation_state ADD COLUMN lifecycle_status TEXT NOT NULL DEFAULT 'ACTIVE';
ALTER TABLE incarnation_state ADD COLUMN lifecycle_changed_at_ms INTEGER NOT NULL DEFAULT 0;
ALTER TABLE incarnation_state ADD COLUMN termination_reason TEXT;
ALTER TABLE incarnation_state ADD COLUMN lifecycle_request_id TEXT;

UPDATE incarnation_state
SET lifecycle_changed_at_ms = created_at_ms
WHERE lifecycle_changed_at_ms = 0;
